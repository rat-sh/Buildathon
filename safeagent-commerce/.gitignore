# ─────────────────────────────────────────────────────────────────────────────
# SafeAgent Commerce — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Environment & secrets — NEVER commit these
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
.docker/

# Alembic — keep env.py, ignore compiled versions
*.pyc

# Logs
*.log
logs/

# Static generated files (keep source, ignore compiled)
backend/app/static/css/tailwind.min.css

# Local test artifacts
test_*.db
safeagent_test.db

# Design exports — must never be in repository
Figma/
figma/
*.fig
design-export/
design_export/
