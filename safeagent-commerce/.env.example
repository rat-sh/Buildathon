# ─────────────────────────────────────────────────────────────────────────────
# SafeAgent Commerce — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development                        # development | production
APP_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
DEBUG=true

# ── Supabase (example project ref: dzajfadmwhexrcloytdr) ────────────────────
SUPABASE_URL=https://dzajfadmwhexrcloytdr.supabase.co
SUPABASE_PROJECT_REF=dzajfadmwhexrcloytdr
SUPABASE_ANON_KEY=REPLACE_ME_WITH_ANON_KEY_FROM_SUPABASE_DASHBOARD

# Primary DB — Session mode (5432), asyncpg driver (required for the app):
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@db.dzajfadmwhexrcloytdr.supabase.co:5432/postgres

# Alternative — Transaction pooler (6543), recommended under load:
# DATABASE_URL=postgresql+asyncpg://postgres.dzajfadmwhexrcloytdr:REPLACE_ME@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase CLI (optional, for migrations):
#   supabase login
#   supabase init
#   supabase link --project-ref dzajfadmwhexrcloytdr

# Offline unit tests only (pytest sets this automatically — do not use for the app):
# DATABASE_URL=sqlite+aiosqlite:///:memory:

# ── Razorpay (TEST MODE ONLY) ─────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys (use TEST keys)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_WITH_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_WITH_WEBHOOK_SECRET

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Use ONE of the following:
OPENAI_API_KEY=sk-REPLACE_ME
# GROQ_API_KEY=gsk_REPLACE_ME

LLM_MODEL=gpt-4o-mini                     # or llama-3.1-8b-instant for Groq

# ── Spending Limits (override defaults in limits.py if needed) ────────────────
# These are hard limits — only override for testing, never for production bypass
# PER_TX_LIMIT_OVERRIDE=5000              # in INR paisa (500000 = ₹5000)
# DAILY_CEILING_OVERRIDE=10000            # in INR paisa

# ── AI Buyer Auth ─────────────────────────────────────────────────────────────
AI_BUYER_API_KEY=test-ai-buyer-key-REPLACE_ME

# ── Admin / Merchant Auth (audit log API) ─────────────────────────────────────
ADMIN_API_KEY=test-admin-key-REPLACE_ME

# ── CORS (JSON array of allowed origins) ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
